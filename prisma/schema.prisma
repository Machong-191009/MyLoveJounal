generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 情侣关系 ====================
model Couple {
  id            String   @id @default(uuid())
  inviteCode    String   @unique @map("invite_code")
  togetherSince DateTime @map("together_since") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  users         User[]
  memories      Memory[]
  albums        Album[]
  media         Media[]
  anniversaries Anniversary[]
  milestones    Milestone[]
  wishes        Wish[]
  travels       Travel[]

  @@map("couples")
}

// ==================== 用户 ====================
model User {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  coupleId  String?  @map("couple_id")
  createdAt DateTime @default(now()) @map("created_at")

  couple    Couple?  @relation(fields: [coupleId], references: [id])
  memories  Memory[]
  media     Media[]

  @@map("users")
}

// ==================== 回忆/时间线 ====================
model Memory {
  id         String   @id @default(uuid())
  coupleId   String   @map("couple_id")
  authorId   String   @map("author_id")
  title      String   @db.VarChar(200)
  content    String?  @db.Text
  memoryDate DateTime @map("memory_date") @db.Date
  location   String?  @db.VarChar(200)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  mood       String?  @db.VarChar(50)
  tags       String[] @default([])
  isPrivate  Boolean  @default(false) @map("is_private")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  couple     Couple   @relation(fields: [coupleId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
  media      Media[]
  wishes     Wish[]

  @@index([coupleId, memoryDate])
  @@map("memories")
}

// ==================== 相册 ====================
model Album {
  id          String   @id @default(uuid())
  coupleId    String   @map("couple_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  couple      Couple   @relation(fields: [coupleId], references: [id])
  media       Media[]

  @@map("albums")
}

// ==================== 媒体文件 ====================
model Media {
  id         String    @id @default(uuid())
  coupleId   String    @map("couple_id")
  memoryId   String?   @map("memory_id")
  albumId    String?   @map("album_id")
  uploaderId String    @map("uploader_id")
  fileUrl    String    @map("file_url") @db.VarChar(500)
  thumbUrl   String?   @map("thumb_url") @db.VarChar(500)
  fileType   String?   @map("file_type") @db.VarChar(20)
  fileSize   BigInt?   @map("file_size")
  caption    String?   @db.Text
  takenAt    DateTime? @map("taken_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  couple     Couple    @relation(fields: [coupleId], references: [id])
  memory     Memory?   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  album      Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploader   User      @relation(fields: [uploaderId], references: [id])

  @@index([coupleId])
  @@index([memoryId])
  @@index([albumId])
  @@map("media")
}

// ==================== 纪念日 ====================
model Anniversary {
  id         String   @id @default(uuid())
  coupleId   String   @map("couple_id")
  title      String   @db.VarChar(200)
  date       DateTime @db.Date
  isLunar    Boolean  @default(false) @map("is_lunar")
  repeatType String   @default("yearly") @map("repeat_type") @db.VarChar(20)
  remind     Boolean  @default(true)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  couple     Couple   @relation(fields: [coupleId], references: [id])

  @@index([coupleId])
  @@map("anniversaries")
}

// ==================== 里程碑 ====================
model Milestone {
  id         String   @id @default(uuid())
  coupleId   String   @map("couple_id")
  type       String?  @db.VarChar(50)
  customType String?  @map("custom_type") @db.VarChar(100)
  date       DateTime? @db.Date
  story      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  couple     Couple   @relation(fields: [coupleId], references: [id])

  @@map("milestones")
}

// ==================== 愿望清单 ====================
model Wish {
  id          String    @id @default(uuid())
  coupleId    String    @map("couple_id")
  title       String    @db.VarChar(200)
  category    String?   @db.VarChar(50)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  memoryId    String?   @map("memory_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  couple      Couple    @relation(fields: [coupleId], references: [id])
  memory      Memory?   @relation(fields: [memoryId], references: [id])

  @@map("wishes")
}

// ==================== 旅行 ====================
model Travel {
  id          String     @id @default(uuid())
  coupleId    String     @map("couple_id")
  title       String     @db.VarChar(200)
  description String?    @db.Text
  coverUrl    String?    @map("cover_url") @db.VarChar(500)
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  status      String     @default("planned") @db.VarChar(20) // planned, ongoing, completed
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  couple      Couple     @relation(fields: [coupleId], references: [id])
  spots       TravelSpot[]

  @@index([coupleId])
  @@map("travels")
}

// ==================== 旅行地点/足迹 ====================
model TravelSpot {
  id          String    @id @default(uuid())
  travelId    String    @map("travel_id")
  name        String    @db.VarChar(200)
  city        String?   @db.VarChar(100)
  country     String?   @db.VarChar(100)
  latitude    Decimal   @db.Decimal(10, 8)
  longitude   Decimal   @db.Decimal(11, 8)
  visitDate   DateTime? @map("visit_date") @db.Date
  note        String?   @db.Text
  photos      String[]  @default([]) // 存储图片 URL 列表
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  travel      Travel    @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId])
  @@map("travel_spots")
}
